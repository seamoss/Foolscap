<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: the App Sandbox is mandatory. Foolscap's file access
       flows through user intent (open dialogs, drag-drop, file associations,
       recent documents) plus security-scoped bookmarks persisted by
       src/main/scoped.ts for session restore and beside-the-document
       writes. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Must match the provisioning profile exactly or the app dies at spawn. -->
  <key>com.apple.application-identifier</key>
  <string>4J2T5H73JM.com.foolscap.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>4J2T5H73JM</string>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- V8 JIT, same as the Developer ID build. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- No network entitlement, deliberately: the App Store edition makes no
       update checks (App Review's rule, and ours), Shiki grammars load from
       the bundle, and links open in the system browser. -->
</dict>
</plist>
